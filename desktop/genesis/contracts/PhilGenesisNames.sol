pragma solidity 0.8.27;
import {PhilGenesisRecipes} from "./PhilGenesisRecipes.sol";
/// @notice Immutable name catalog; NFT permanently claims each unique name ID.
/// @dev Immutable catalog; only the creating NFT can permanently claim a name. Generated from unique-names/catalog.json.
contract PhilGenesisNames {
    error InvalidName();
    uint256 public constant NAME_COUNT=8352;
    address public immutable nft=msg.sender;
    mapping(uint256=>uint256) public tokenIdForName;
    mapping(uint256=>bool) public nameClaimed;
    mapping(uint256=>uint256) public nameIdOf;
    function isNameAvailable(uint256 id) external view returns(bool){return id>0&&id<=NAME_COUNT&&!nameClaimed[id];}
    function claim(uint256 choiceId,uint256 tokenId) external returns(uint256 recipeId,uint256 nameId){
        if(msg.sender!=nft||choiceId==0||choiceId>PhilGenesisRecipes.SUPPLY*NAME_COUNT||tokenId>=369||nameIdOf[tokenId]!=0)revert InvalidName();
        recipeId=(choiceId-1)%PhilGenesisRecipes.SUPPLY+1;nameId=(choiceId-1)/PhilGenesisRecipes.SUPPLY+1;
        if(nameClaimed[nameId])revert InvalidName();nameClaimed[nameId]=true;tokenIdForName[nameId]=tokenId;nameIdOf[tokenId]=nameId;
    }
    bytes private constant WORDS=hex"";
    bytes private constant PREFIXES=hex"";
    bytes private constant SUFFIXES=hex"";
    // Adjacent 16-bit offsets bound each word, without per-word length bytes.
    function _word(bytes memory table,uint256 index) private pure returns(string memory out) {
        assembly("memory-safe") {
            let data:=add(table,32)
            let row:=add(data,mul(index,2))
            let begin:=shr(240,mload(row))
            let at:=add(data,begin)
            let n:=sub(shr(240,mload(add(row,2))),begin)
            out:=mload(0x40) mstore(out,n)
            mcopy(add(out,32),at,n)
            mstore(add(add(out,32),n),0)
            mstore(0x40,add(out,and(add(n,95),not(31))))
        }
    }
    function encodedName(uint256 nameId) external pure returns(string memory) {
        if(nameId==0||nameId>NAME_COUNT)revert InvalidName();uint256 i=nameId-1;
        if(i<160)return string.concat("Phil-",_word(WORDS,i));
        i-=160;return string.concat("Phil-",_word(PREFIXES,i/64),_word(SUFFIXES,i%64));
    }
}
